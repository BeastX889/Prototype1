{
  "expo": {
    "name": "Round Timer",
    "slug": "boxing-mma-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roundtimer",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#10161d",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumiolab.roundtimer"
    },
    "android": {
      "package": "com.lumiolab.roundtimer",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#10161d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0b9b3d",
          "sounds": [
            "./assets/sounds/bell.wav",
            "./assets/sounds/end_bell.wav",
            "./assets/sounds/final_bell.wav",
            "./assets/sounds/warning.wav",
            "./assets/sounds/beep.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10161d",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/withExactAlarms"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/Prototype1"
    }
  }
}
